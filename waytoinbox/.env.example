# ============================================================
# PRODUCTION .env
# NEVER commit .env to version control.
# ============================================================


# ── Django core ─────────────────────────────────────────────

DJANGO_ENV=production
DJANGO_DEBUG=False

ALLOWED_HOSTS=waytoinbox.com,app.waytoinbox.com,www.waytoinbox.com,74.118.170.2

SECRET_KEY=YOUR_EXISTING_LIVE_SECRET_KEY


# ── Admin URL ───────────────────────────────────────────────

ADMIN_URL=admin_Win/


# ── Database ────────────────────────────────────────────────

DB_NAME=Innovicloud
DB_USER=innovicloud_user
DB_PASSWORD=YOUR_EXISTING_LIVE_DB_PASSWORD
DB_HOST=localhost
DB_PORT=3306

DB_SSL_CA=

# Optional
# DB_CONN_MAX_AGE=60


# ── Redis ───────────────────────────────────────────────────

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=YOUR_EXISTING_LIVE_REDIS_PASSWORD

# Optional
# REDIS_URL=redis://:password@127.0.0.1:6379


# ── Reverse Proxy ───────────────────────────────────────────

NUM_PROXIES=1


# ── Email (Transactional) ──────────────────────────────────

EMAIL_HOST_USER=support@waytoinbox.com
EMAIL_HOST_PASSWORD=YOUR_EXISTING_LIVE_EMAIL_PASSWORD

DJANGO_ADMINS=Prasanth:waytoinbox@outlook.com
SERVER_EMAIL=support@waytoinbox.com


# ── Razorpay ────────────────────────────────────────────────

RAZORPAY_KEY_ID=YOUR_EXISTING_LIVE_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_EXISTING_LIVE_RAZORPAY_KEY_SECRET


# ── AWS SES ─────────────────────────────────────────────────

AWS_SES_ACCESS_KEY_ID=YOUR_EXISTING_LIVE_AWS_ACCESS_KEY_ID
AWS_SES_SECRET_ACCESS_KEY=YOUR_EXISTING_LIVE_AWS_SECRET_ACCESS_KEY
AWS_SES_REGION=us-east-1
AWS_SES_SOURCE_EMAIL=support@waytoinbox.com
AWS_SES_CONFIGURATION_SET=tracking-config


# ── Email Provider ──────────────────────────────────────────

EMAIL_PROVIDER=mailgun

MAILGUN_API_KEY=YOUR_EXISTING_LIVE_MAILGUN_API_KEY
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=YOUR_MAILGUN_DOMAIN


# ── Google Postmaster OAuth2 ────────────────────────────────

GOOGLE_TOKEN_JSON=YOUR_EXISTING_LIVE_GOOGLE_TOKEN_JSON
GOOGLE_CREDENTIALS_JSON=YOUR_EXISTING_LIVE_GOOGLE_CREDENTIALS_JSON


# ── Warmup: Gmail Receiver OAuth2 ──────────────────────────
#
# Separate OAuth client from Google Postmaster.
# Used for admin-managed Gmail warmup receiver accounts.
#

GOOGLE_OAUTH_CLIENT_ID=YOUR_WARMUP_GOOGLE_OAUTH_CLIENT_ID

GOOGLE_OAUTH_CLIENT_SECRET=YOUR_WARMUP_GOOGLE_OAUTH_CLIENT_SECRET

GOOGLE_OAUTH_REDIRECT_URI=https://waytoinbox.com/wti-admin/warmup-receivers/oauth/callback/


# ── Warmup OAuth Token Encryption ───────────────────────────

WARMUP_TOKEN_ENCRYPTION_KEY=YOUR_WARMUP_FERNET_KEY


# ── Warmup Verification / Retry Config ─────────────────────

# Optional — defaults are used if these are not set.
# WARMUP_INITIAL_CHECK_DELAY_MINUTES=30
# WARMUP_CHECK_BACKOFF_MINUTES=15,45,120
# WARMUP_MAX_CHECK_ATTEMPTS=3
# WARMUP_MAX_SEND_ATTEMPTS=3


# ── Site URL ────────────────────────────────────────────────

SITE_URL=https://waytoinbox.com


# ── Sales Outreach Open/Click Tracking ─────────────────────
#
# Gates inject_tracking() in services/so_smtp.py — the open pixel and
# click-link rewriting for every Sales Outreach send. Defaults to '1'
# automatically whenever DJANGO_ENV=production (as set above), so this
# does not strictly need to be set explicitly here — included so the
# behavior is documented and can be confirmed/overridden without reading
# the settings.py default logic. Only set to 0 to deliberately disable
# tracking even in production.
#
ENABLE_EMAIL_TRACKING=1


# ── Campaign Batch Config ──────────────────────────────────

EMAIL_BATCH_SIZE=500
EMAIL_BATCH_DELAY=60

EMAIL_MAX_CONCURRENT_BATCHES=1
EMAIL_BATCH_RETRY_COUNT=3
EMAIL_BATCH_RETRY_DELAY=30


# ── Email Validation Config ─────────────────────────────────

EMAIL_VALIDATION_CONCURRENCY=150
EMAIL_VALIDATION_DAILY_LIMIT=5
EMAIL_VALIDATION_CHUNK_SIZE=500
EMAIL_VALIDATION_MAX_WORKERS=50


# ── List/Table Filter Config ────────────────────────────────

# Optional — shared filter-bar pagination/search defaults.

# FILTER_SEARCH_DEBOUNCE_MS=300
# FILTER_DEFAULT_PAGE_SIZE=25
# FILTER_MAX_PAGE_SIZE=100
# FILTER_SLOW_QUERY_MS=500