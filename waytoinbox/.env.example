# ============================================================

# .env.example

# Copy to .env and fill in real values.

# NEVER commit .env to version control.

# ============================================================

# ── Django core ─────────────────────────────────────────────

DJANGO_ENV=production
DJANGO_DEBUG=False
ALLOWED_HOSTS=waytoinbox.com,app.waytoinbox.com,[www.waytoinbox.com,SERVER_IP](http://www.waytoinbox.com,SERVER_IP)
SECRET_KEY=your_django_secret_key

# ── Admin URL ───────────────────────────────────────────────

ADMIN_URL=admin/

# ── Database ────────────────────────────────────────────────

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# Path to CA cert for encrypted MySQL (leave blank if unused)

DB_SSL_CA=

# ── Redis ───────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional full Redis URL

# REDIS_URL=redis://:password@host:port

# ── Reverse Proxy ───────────────────────────────────────────

NUM_PROXIES=1

# ── Email (Transactional) ───────────────────────────────────

EMAIL_HOST_USER=[your_email@example.com](mailto:your_email@example.com)
EMAIL_HOST_PASSWORD=your_email_password

DJANGO_ADMINS=Ops Team:ops@example.com
SERVER_EMAIL=[noreply@example.com](mailto:noreply@example.com)

# ── Razorpay ────────────────────────────────────────────────

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── AWS SES ─────────────────────────────────────────────────

AWS_SES_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_REGION=us-east-1
AWS_SES_SOURCE_EMAIL=[your_verified_email@example.com](mailto:your_verified_email@example.com)
AWS_SES_CONFIGURATION_SET=tracking-config

# ── Email Provider ──────────────────────────────────────────

EMAIL_PROVIDER=ses
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_BASE_URL=https://api.mailgun.net

# ── Google Postmaster OAuth2 ────────────────────────────────

GOOGLE_TOKEN_JSON=
GOOGLE_CREDENTIALS_JSON=

# ── Site URL ────────────────────────────────────────────────

SITE_URL=https://waytoinbox.com

# ── Campaign Batch Config ───────────────────────────────────

EMAIL_BATCH_SIZE=500
EMAIL_BATCH_DELAY=60
EMAIL_MAX_CONCURRENT_BATCHES=1
EMAIL_BATCH_RETRY_COUNT=3
EMAIL_BATCH_RETRY_DELAY=30

# ── Email Validation Config ─────────────────────────────────

EMAIL_VALIDATION_CONCURRENCY=150
EMAIL_VALIDATION_DAILY_LIMIT=5
EMAIL_VALIDATION_CHUNK_SIZE=500
EMAIL_VALIDATION_MAX_WORKERS=50
