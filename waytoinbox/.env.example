# ============================================================

# .env.example

# Copy to .env and fill in real values.

# NEVER commit .env to version control.

# ============================================================

# ── Django core ─────────────────────────────────────────────

DJANGO_ENV=production
DJANGO_DEBUG=False
ALLOWED_HOSTS=waytoinbox.com,app.waytoinbox.com,[www.waytoinbox.com,SERVER_IP](http://www.waytoinbox.com,SERVER_IP)
SECRET_KEY=your_django_secret_key

# ── Admin URL ───────────────────────────────────────────────

ADMIN_URL=admin/

# ── Database ────────────────────────────────────────────────

DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=your_database_password
DB_HOST=localhost
DB_PORT=3306

# Path to CA cert for encrypted MySQL (leave blank if unused)

DB_SSL_CA=

# Optional — DB connection persistence (seconds)
# DB_CONN_MAX_AGE=60

# ── Redis ───────────────────────────────────────────────────

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Optional full Redis URL

# REDIS_URL=redis://:password@host:port

# ── Reverse Proxy ───────────────────────────────────────────

NUM_PROXIES=1

# ── Email (Transactional) ───────────────────────────────────

EMAIL_HOST_USER=[your_email@example.com](mailto:your_email@example.com)
EMAIL_HOST_PASSWORD=your_email_password

DJANGO_ADMINS=Ops Team:ops@example.com
SERVER_EMAIL=[noreply@example.com](mailto:noreply@example.com)

# ── Razorpay ────────────────────────────────────────────────

RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ── AWS SES ─────────────────────────────────────────────────

AWS_SES_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SES_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_SES_REGION=us-east-1
AWS_SES_SOURCE_EMAIL=[your_verified_email@example.com](mailto:your_verified_email@example.com)
AWS_SES_CONFIGURATION_SET=tracking-config

# ── Email Provider ──────────────────────────────────────────

EMAIL_PROVIDER=ses
MAILGUN_API_KEY=your_mailgun_api_key
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_DOMAIN=

# ── Google Postmaster OAuth2 ────────────────────────────────

GOOGLE_TOKEN_JSON=
GOOGLE_CREDENTIALS_JSON=

# ── Warmup: Gmail receiver OAuth2 (separate from Postmaster above — this is
# a per-receiver-account "Web application" OAuth client, scope
# gmail.modify, NOT the Postmaster "Desktop app" client type). Receivers are
# a fixed, admin-managed shared pool — this flow is only ever run from the
# admin console (wti-admin/warmup-receivers/), never by end users. ────────

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://your-domain.example/wti-admin/warmup-receivers/oauth/callback/

# Fernet key for encrypting receiver OAuth refresh tokens at rest — generate
# once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
WARMUP_TOKEN_ENCRYPTION_KEY=

# Optional — override the warmup verification timing/retry defaults (30 min
# initial delay, then +15/+45/+120 min backoff, 3 attempts before a message
# is marked not_found, 3 attempts before a send is marked failed).
# WARMUP_INITIAL_CHECK_DELAY_MINUTES=30
# WARMUP_CHECK_BACKOFF_MINUTES=15,45,120
# WARMUP_MAX_CHECK_ATTEMPTS=3
# WARMUP_MAX_SEND_ATTEMPTS=3

# ── Site URL ────────────────────────────────────────────────

SITE_URL=https://waytoinbox.com

# ── Campaign Batch Config ───────────────────────────────────

EMAIL_BATCH_SIZE=500
EMAIL_BATCH_DELAY=60
EMAIL_MAX_CONCURRENT_BATCHES=1
EMAIL_BATCH_RETRY_COUNT=3
EMAIL_BATCH_RETRY_DELAY=30

# ── Email Validation Config ─────────────────────────────────

EMAIL_VALIDATION_CONCURRENCY=150
EMAIL_VALIDATION_DAILY_LIMIT=5
EMAIL_VALIDATION_CHUNK_SIZE=500
EMAIL_VALIDATION_MAX_WORKERS=50

# ── List/Table Filter Config ────────────────────────────────
# Optional — override the shared filter-bar pagination/search defaults used
# across the app's list pages.
# FILTER_SEARCH_DEBOUNCE_MS=300
# FILTER_DEFAULT_PAGE_SIZE=25
# FILTER_MAX_PAGE_SIZE=100
# FILTER_SLOW_QUERY_MS=500
