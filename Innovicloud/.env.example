# ============================================================
# .env.example — copy to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ── Django core ─────────────────────────────────────────────
DJANGO_ENV=local                        # 'local' | 'production'
DJANGO_DEBUG=True                       # Must be False in production
ALLOWED_HOSTS=localhost,127.0.0.1       # Comma-separated; add your domain in production
SECRET_KEY=CHANGE-ME-use-a-50-char-random-string

# ── Admin URL (SEC-09) ──────────────────────────────────────
# Set to an unguessable slug in production, e.g. mgt-a8f3c2e9b1/
ADMIN_URL=admin/

# ── Database ─────────────────────────────────────────────────
DB_NAME=Innovicloud
DB_USER=root
DB_PASSWORD=CHANGE-ME
DB_HOST=localhost
DB_PORT=3306
# INF-03: path to CA cert for encrypted MySQL in production
# e.g. /etc/ssl/certs/ca-certificates.crt on Ubuntu
DB_SSL_CA=

# ── Redis (INF-02 / INF-08) ──────────────────────────────────
# In production: set REDIS_PASSWORD (requirepass in redis.conf) to prevent
# rate-limit bypass and Celery task injection.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# Or override the whole URL: redis://:password@host:port
# REDIS_URL=

# ── Reverse-proxy depth (INF-08) ────────────────────────────
# Number of trusted reverse proxies in front of gunicorn (0 = none, 1 = nginx).
# Controls which X-Forwarded-For entry is used as the real client IP.
NUM_PROXIES=0

# ── Email (transactional) ────────────────────────────────────
EMAIL_HOST_USER=support@example.com
EMAIL_HOST_PASSWORD=CHANGE-ME
# INF-14: production 500-error alerts — "Name:email@domain.com", comma-separated
DJANGO_ADMINS=Ops Team:ops@example.com
SERVER_EMAIL=noreply@example.com

# ── Razorpay ────────────────────────────────────────────────
# Use rzp_test_* keys for dev, rzp_live_* for production
RAZORPAY_KEY_ID=rzp_test_CHANGE-ME
RAZORPAY_KEY_SECRET=CHANGE-ME

# ── AWS SES (campaign sending) ───────────────────────────────
AWS_SES_ACCESS_KEY_ID=CHANGE-ME
AWS_SES_SECRET_ACCESS_KEY=CHANGE-ME
AWS_SES_REGION=us-east-1
AWS_SES_SOURCE_EMAIL=
AWS_SES_CONFIGURATION_SET=tracking-config

# ── Email provider ────────────────────────────────────────────
EMAIL_PROVIDER=ses                      # 'ses' or 'mailgun'
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_BASE_URL=https://api.mailgun.net

# ── Google Postmaster OAuth2 ──────────────────────────────────
GOOGLE_TOKEN_JSON=
GOOGLE_CREDENTIALS_JSON=

# ── Site URL ──────────────────────────────────────────────────
SITE_URL=https://example.com

# ── Campaign batch config ─────────────────────────────────────
EMAIL_BATCH_SIZE=500
EMAIL_BATCH_DELAY=60
EMAIL_MAX_CONCURRENT_BATCHES=1
EMAIL_BATCH_RETRY_COUNT=3
EMAIL_BATCH_RETRY_DELAY=30

# ── Email validation config ───────────────────────────────────
EMAIL_VALIDATION_CONCURRENCY=150
EMAIL_VALIDATION_DAILY_LIMIT=5
EMAIL_VALIDATION_CHUNK_SIZE=500
EMAIL_VALIDATION_MAX_WORKERS=50
